{
  "name": "shop-manager",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "npm --prefix client install --no-audit --no-fund && npm --prefix client run build",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply shop-manager-db --local",
    "db:remote": "wrangler d1 migrations apply shop-manager-db --remote",
    "reset-admin": "node worker/scripts/reset-admin.js"
  },
  "dependencies": { "hono": "^4.6.0" },
  "devDependencies": { "wrangler": "^4.0.0" }
}
